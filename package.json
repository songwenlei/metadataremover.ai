{
  "name": "metadataremover-ai-toolkit",
  "version": "0.8.0",
  "description": "Local, privacy-first tools for viewing, editing, checking, and removing image, PDF, DOCX, video, and MP3 metadata.",
  "type": "module",
  "bin": {
    "ai-metadata-remove": "./bin/ai-metadata-remove.js",
    "metadata-check": "./bin/metadata-check.js",
    "metadata-view": "./bin/metadata-view.js",
    "metadata-edit": "./bin/metadata-edit.js",
    "metadata-remove": "./bin/metadata-remove.js",
    "exif-remove": "./bin/exif-remove.js",
    "pdf-metadata-view": "./bin/pdf-metadata-view.js",
    "pdf-metadata-edit": "./bin/pdf-metadata-edit.js",
    "pdf-metadata-remove": "./bin/pdf-metadata-remove.js",
    "docx-metadata-view": "./bin/docx-metadata-view.js",
    "docx-metadata-edit": "./bin/docx-metadata-edit.js",
    "docx-metadata-remove": "./bin/docx-metadata-remove.js",
    "video-metadata-view": "./bin/video-metadata-view.js",
    "video-metadata-edit": "./bin/video-metadata-edit.js",
    "video-metadata-remove": "./bin/video-metadata-remove.js",
    "mp3-metadata-view": "./bin/mp3-metadata-view.js",
    "mp3-metadata-edit": "./bin/mp3-metadata-edit.js",
    "mp3-metadata-remove": "./bin/mp3-metadata-remove.js"
  },
  "scripts": {
    "check": "for file in bin/*.js src/*.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "exif",
    "metadata",
    "privacy",
    "gps",
    "jpeg",
    "png",
    "webp",
    "xmp",
    "iptc",
    "ai-metadata",
    "ai-metadata-remover",
    "metadata-viewer",
    "metadata-editor",
    "metadata-remover",
    "exif-remover",
    "pdf-metadata",
    "pdf-metadata-viewer",
    "pdf-metadata-editor",
    "pdf-metadata-remover",
    "docx-metadata",
    "docx-metadata-viewer",
    "docx-metadata-editor",
    "docx-metadata-remover",
    "video-metadata",
    "video-metadata-viewer",
    "video-metadata-editor",
    "video-metadata-remover",
    "mp3-metadata",
    "id3",
    "id3v2",
    "mp3-metadata-editor",
    "mp3-metadata-remover"
  ],
  "homepage": "https://metadataremover.ai/",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/songwenlei/metadataremover.ai.git"
  },
  "bugs": {
    "url": "https://github.com/songwenlei/metadataremover.ai/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  }
}
